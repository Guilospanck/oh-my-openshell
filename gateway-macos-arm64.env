# Environment of the OpenShell gateway on Apple Silicon macOS. osh picks the file for this machine
# by OS and architecture (gateway-linux.env, gateway-macos-arm64.env, gateway-macos-x86_64.env).
DOCKER_HOST="unix://${HOME}/.colima/docker.sock"
PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
