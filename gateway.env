# Legacy, macOS only: osh no longer reads this file on Linux. It picks gateway-linux.env,
# gateway-macos-arm64.env or gateway-macos-x86_64.env by OS and architecture. Kept so a dotfiles
# setup that links this name keeps building; the Homebrew service on macOS still reads it.
DOCKER_HOST="unix://${HOME}/.colima/docker.sock"
PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
