# syntax=docker/dockerfile:1

# Claude Code executes shell commands and needs OS tools.
FROM node:24-bookworm-slim AS claude-install

# Rebuild with --no-cache to refresh the latest version.
ARG CLAUDE_CODE_VERSION=latest
# Keep lifecycle scripts enabled: postinstall sets up the native executable.
RUN npm install --global --omit=dev --allow-scripts=@anthropic-ai/claude-code \
    "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && claude --version

FROM node:24-bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        less \
        python3 \
        ripgrep \
        tmux \
        vim-tiny \
    && rm -rf /var/lib/apt/lists/*

# gh from GitHub's own apt repository: Debian's package is too old for current GitHub APIs.
# /usr/bin/gh is a path the github provider profile allows.
RUN mkdir -p -m 755 /etc/apt/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install --yes --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/* \
    && gh --version

# workmux drives tmux windows; /etc/tmux.conf lets copies and Shift-Enter reach osh's embedded
# terminal (set-clipboard forwards OSC 52, extended-keys keeps modified Enter distinct). The window title
# carries workmux's status icon and the git branch as `osh-status:<icon>|<branch>`: osh shows the
# branch in the shell's bar and mirrors the status onto its host tmux window.
# Pinned: rebuild with --build-arg WORKMUX_VERSION=<tag> to change. The archive is checked
# against the checksum file published with the release.
ARG WORKMUX_VERSION=v0.1.277
RUN arch="$(dpkg --print-architecture)" \
    && base="https://github.com/raine/workmux/releases/download/${WORKMUX_VERSION}" \
    && cd /tmp \
    && curl -fsSLO "${base}/workmux-linux-${arch}.tar.gz" \
    && curl -fsSL "${base}/workmux-linux-${arch}.sha256" | sha256sum --check - \
    && tar -xzf "workmux-linux-${arch}.tar.gz" -C /usr/local/bin workmux \
    && rm "workmux-linux-${arch}.tar.gz" \
    && workmux --version \
    && printf '%s\n' \
        'set -g set-clipboard on' \
        "set -as terminal-features ',*:clipboard'" \
        'set -g extended-keys on' \
        'set -g set-titles on' \
        'set -g status-interval 5' \
        'set -g set-titles-string "osh-status:#{@workmux_status}|#(git -C \"#{pane_current_path}\" branch --show-current 2>/dev/null)"' \
        > /etc/tmux.conf

# just (https://github.com/casey/just) runs project recipes. Pinned: rebuild with
# --build-arg JUST_VERSION=<version> to change. The archive is checked against the release's
# SHA256SUMS.
ARG JUST_VERSION=1.59.0
RUN case "$(dpkg --print-architecture)" in \
        amd64) triple=x86_64-unknown-linux-musl ;; \
        arm64) triple=aarch64-unknown-linux-musl ;; \
        *) echo "unsupported architecture" >&2; exit 1 ;; \
    esac \
    && base="https://github.com/casey/just/releases/download/${JUST_VERSION}" \
    && archive="just-${JUST_VERSION}-${triple}.tar.gz" \
    && cd /tmp \
    && curl -fsSLO "${base}/${archive}" \
    && curl -fsSL "${base}/SHA256SUMS" | grep -F " ${archive}" | sha256sum --check - \
    && tar -xzf "${archive}" -C /usr/local/bin just \
    && rm "${archive}" \
    && just --version

COPY --from=claude-install /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/@anthropic-ai/claude-code/bin/claude.exe /usr/local/bin/claude \
    && mkdir -p /workspace /home/node/.claude \
    && chown -R node:node /workspace /home/node/.claude

# uv installs graphify (a Python tool); python3 above satisfies its 3.10+ need.
COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /uvx /usr/local/bin/

ENV NODE_ENV=production \
    HOME=/home/node \
    DISABLE_AUTOUPDATER=1

USER node
WORKDIR /workspace

# Supply credentials at runtime; never bake them into the image.
# For persistent state, preserve both /home/node/.claude and /home/node/.claude.json.
