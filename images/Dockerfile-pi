# syntax=docker/dockerfile:1

# pi (https://github.com/badlogic/pi-mono) executes shell commands and needs OS tools.
FROM node:24-bookworm-slim AS runtime

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        git \
        less \
        python3 \
        ripgrep \
        vim-tiny \
    && rm -rf /var/lib/apt/lists/*

# gh from GitHub's own apt repository: Debian's package is too old for current GitHub APIs.
# /usr/bin/gh is a path the github provider profile allows.
RUN mkdir -p -m 755 /etc/apt/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install --yes --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/* \
    && gh --version

# Pinned: rebuild with --build-arg PI_VERSION=<version> to change. Keep in step with the host.
ARG PI_VERSION=1.4.0
RUN npm install --global --omit=dev "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    && pi --version

# pi reads skills from ~/.agents/skills and ~/.pi/agent/skills, context from ~/.pi/agent.
RUN mkdir -p /workspace /home/node/.pi/agent /home/node/.agents/skills \
    && chown -R node:node /workspace /home/node/.pi /home/node/.agents

# uv installs graphify (a Python tool); python3 above satisfies its 3.10+ need.
COPY --from=ghcr.io/astral-sh/uv:0.13.5 /uv /uvx /usr/local/bin/

ENV NODE_ENV=production \
    HOME=/home/node

USER node
WORKDIR /workspace

# Supply credentials at runtime (provider or login); never bake them into the image.
# For persistent state, preserve /home/node/.pi/agent.
