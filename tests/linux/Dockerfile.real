# A machine with systemd as PID 1 and an ordinary sudo user, for tests/linux/real.sh. Nothing
# osh needs is installed here: osh setup does that, as it would on a fresh Ubuntu host.
FROM ubuntu:24.04
ENV container=docker DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
    && apt-get install -y --no-install-recommends systemd systemd-sysv dbus dbus-user-session \
        sudo curl ca-certificates iproute2 uidmap python3 \
    && rm -rf /var/lib/apt/lists/*
RUN useradd -m -s /bin/bash tester \
    && echo 'tester ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/tester
# Docker nested in a container cannot mount overlay on overlay; vfs works anywhere. A test-machine
# setting only: a real host has no reason to need it. (Podman is unaffected.)
RUN mkdir -p /etc/docker \
    && echo '{"storage-driver":"vfs","features":{"containerd-snapshotter":false}}' > /etc/docker/daemon.json
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
