# Environment of the OpenShell gateway on Intel macOS (Homebrew lives in /usr/local). osh picks the
# file for this machine by OS and architecture (gateway-linux.env, gateway-macos-arm64.env,
# gateway-macos-x86_64.env).
DOCKER_HOST="unix://${HOME}/.colima/docker.sock"
PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
